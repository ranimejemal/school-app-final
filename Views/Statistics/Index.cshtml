@model StatisticsViewModel
@{
    ViewData["Title"] = "Statistiques";
    var groupeLabels    = System.Text.Json.JsonSerializer.Serialize(Model.GroupeLabels);
    var absencesData    = System.Text.Json.JsonSerializer.Serialize(Model.AbsencesParGroupe);
    var moduleLabels    = System.Text.Json.JsonSerializer.Serialize(Model.ModuleLabels);
    var moyennesData    = System.Text.Json.JsonSerializer.Serialize(Model.MoyennesNotes);
}

<h4 class="page-title mb-4"><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Statistiques</h4>

<!-- KPIs -->
<div class="row g-3 mb-4">
    @foreach (var (icon, label, value, color) in new (string,string,int,string)[]
    {
        ("bi-people-fill",        "Étudiants",   Model.TotalEtudiants,   "kpi-blue"),
        ("bi-person-badge-fill",  "Professeurs", Model.TotalProfesseurs, "kpi-purple"),
        ("bi-book-fill",          "Modules",     Model.TotalModules,     "kpi-teal"),
        ("bi-diagram-3-fill",     "Groupes",     Model.TotalGroupes,     "kpi-green"),
        ("bi-calendar-x-fill",    "Absences",    Model.TotalAbsences,    "kpi-pink"),
        ("bi-file-earmark-check", "Examens",     Model.TotalExamens,     "kpi-orange"),
    })
    {
        <div class="col-6 col-md-4 col-lg-2">
            <div class="kpi-card @color">
                <div class="kpi-icon"><i class="bi @icon"></i></div>
                <div class="kpi-value">@value</div>
                <div class="kpi-label">@label</div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <!-- Chart 1: Absences par groupe -->
    <div class="col-md-6">
        <div class="card-panel">
            <div class="panel-header"><h5><i class="bi bi-bar-chart-fill text-danger me-2"></i>Absences par groupe</h5></div>
            <canvas id="chartAbsences" height="250"></canvas>
        </div>
    </div>

    <!-- Chart 2: Moyenne notes par module -->
    <div class="col-md-6">
        <div class="card-panel">
            <div class="panel-header"><h5><i class="bi bi-activity text-success me-2"></i>Moyenne des notes par module</h5></div>
            <canvas id="chartNotes" height="250"></canvas>
        </div>
    </div>

    <!-- Chart 3: Absences justifiées vs non -->
    <div class="col-md-6">
        <div class="card-panel">
            <div class="panel-header"><h5><i class="bi bi-pie-chart-fill text-primary me-2"></i>Absences : justifiées vs non</h5></div>
            <canvas id="chartJustif" height="250"></canvas>
        </div>
    </div>

    <!-- Stats summary -->
    <div class="col-md-6">
        <div class="card-panel h-100">
            <div class="panel-header"><h5><i class="bi bi-list-check text-warning me-2"></i>Résumé</h5></div>
            <div class="stats-summary">
                <div class="stats-row">
                    <span>Absences justifiées</span>
                    <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height:8px;width:150px">
                            @{var pct = Model.TotalAbsences > 0 ? (int)(Model.AbsencesJustifiees * 100.0 / Model.TotalAbsences) : 0;}
                            <div class="progress-bar bg-success" style="width:@pct%"></div>
                        </div>
                        <strong>@Model.AbsencesJustifiees</strong>
                    </div>
                </div>
                <div class="stats-row">
                    <span>Absences non justifiées</span>
                    <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height:8px;width:150px">
                            @{var pct2 = Model.TotalAbsences > 0 ? (int)(Model.AbsencesNonJustifiees * 100.0 / Model.TotalAbsences) : 0;}
                            <div class="progress-bar bg-danger" style="width:@pct2%"></div>
                        </div>
                        <strong>@Model.AbsencesNonJustifiees</strong>
                    </div>
                </div>
                @if (Model.MoyennesNotes.Any())
                {
                    <div class="stats-row">
                        <span>Meilleure moyenne</span>
                        <strong class="text-success">@Model.MoyennesNotes.Max().ToString("0.00")/20</strong>
                    </div>
                    <div class="stats-row">
                        <span>Moyenne générale</span>
                        <strong class="text-primary">@Model.MoyennesNotes.Average().ToString("0.00")/20</strong>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const palette = ['#6c5ce7','#a29bfe','#fd79a8','#fdcb6e','#00cec9','#55efc4','#e17055','#74b9ff'];

// Chart 1 – Absences par groupe
new Chart(document.getElementById('chartAbsences'), {
    type: 'bar',
    data: {
        labels: @Html.Raw(groupeLabels),
        datasets: [{ label: 'Absences', data: @Html.Raw(absencesData),
            backgroundColor: palette, borderRadius: 8, borderSkipped: false }]
    },
    options: { responsive: true, plugins: { legend: { display: false } },
               scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
});

// Chart 2 – Moyennes par module
new Chart(document.getElementById('chartNotes'), {
    type: 'line',
    data: {
        labels: @Html.Raw(moduleLabels),
        datasets: [{ label: 'Moyenne /20', data: @Html.Raw(moyennesData),
            borderColor: '#6c5ce7', backgroundColor: 'rgba(108,92,231,.15)',
            fill: true, tension: 0.4, pointBackgroundColor: '#6c5ce7', pointRadius: 5 }]
    },
    options: { responsive: true,
               scales: { y: { beginAtZero: true, max: 20 } } }
});

// Chart 3 – Pie justifiées
new Chart(document.getElementById('chartJustif'), {
    type: 'doughnut',
    data: {
        labels: ['Justifiées', 'Non justifiées'],
        datasets: [{ data: [@Model.AbsencesJustifiees, @Model.AbsencesNonJustifiees],
            backgroundColor: ['#00cec9','#fd79a8'], borderWidth: 0 }]
    },
    options: { responsive: true, cutout: '65%',
               plugins: { legend: { position: 'bottom' } } }
});
</script>
}
