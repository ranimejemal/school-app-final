@model Absence
@{ViewData["Title"] = "Enregistrer une absence";}
<div class="row justify-content-center"><div class="col-lg-6"><div class="card-panel">
    <h5 class="mb-4"><i class="bi bi-calendar-x text-danger me-2"></i>Nouvelle absence</h5>

    <div class="alert alert-info py-2 small mb-4">
        <i class="bi bi-info-circle me-1"></i>
        Un étudiant ne peut être enregistré absent <strong>qu'une seule fois</strong> par séance (même module, même professeur, même date).
    </div>

    <form asp-action="Create">
        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
        <div class="mb-3">
            <label asp-for="EtudiantId" class="form-label fw-semibold"></label>
            <select asp-for="EtudiantId" class="form-select" asp-items="ViewBag.EtudiantId">
                <option value="">— Choisir un étudiant —</option>
            </select>
            <span asp-validation-for="EtudiantId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ProfesseurId" class="form-label fw-semibold"></label>
            <select asp-for="ProfesseurId" class="form-select" asp-items="ViewBag.ProfesseurId">
                <option value="">— Choisir un professeur —</option>
            </select>
            <span asp-validation-for="ProfesseurId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ModuleId" class="form-label fw-semibold"></label>
            <select asp-for="ModuleId" class="form-select" asp-items="ViewBag.ModuleId">
                <option value="">— Choisir le module (séance) —</option>
            </select>
            <span asp-validation-for="ModuleId" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Date_debut" class="form-label fw-semibold"></label>
                <input asp-for="Date_debut" type="date" class="form-control"/>
                <span asp-validation-for="Date_debut" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Date_fin" class="form-label fw-semibold"></label>
                <input asp-for="Date_fin" type="date" class="form-control"/>
                <span asp-validation-for="Date_fin" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Justification" class="form-label fw-semibold"></label>
            <textarea asp-for="Justification" class="form-control" rows="3" placeholder="Laisser vide si non justifiée…"></textarea>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary-custom">Enregistrer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
