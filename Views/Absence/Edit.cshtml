@model Absence
@{ViewData["Title"] = "Modifier absence";}
<div class="row justify-content-center"><div class="col-lg-6"><div class="card-panel">
    <h5 class="mb-4"><i class="bi bi-pencil-square text-warning me-2"></i>Modifier absence</h5>
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id"/>
        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
        <div class="mb-3">
            <label asp-for="EtudiantId" class="form-label fw-semibold"></label>
            <select asp-for="EtudiantId" class="form-select" asp-items="ViewBag.EtudiantId"></select>
        </div>
        <div class="mb-3">
            <label asp-for="ProfesseurId" class="form-label fw-semibold"></label>
            <select asp-for="ProfesseurId" class="form-select" asp-items="ViewBag.ProfesseurId"></select>
        </div>
        <div class="mb-3">
            <label asp-for="ModuleId" class="form-label fw-semibold"></label>
            <select asp-for="ModuleId" class="form-select" asp-items="ViewBag.ModuleId"></select>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Date_debut" class="form-label fw-semibold"></label>
                <input asp-for="Date_debut" type="date" class="form-control"/>
            </div>
            <div class="col-md-6">
                <label asp-for="Date_fin" class="form-label fw-semibold"></label>
                <input asp-for="Date_fin" type="date" class="form-control"/>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Justification" class="form-label fw-semibold"></label>
            <textarea asp-for="Justification" class="form-control" rows="3"></textarea>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-warning text-white">Mettre à jour</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
