@model Affectation
@{ViewData["Title"] = "Supprimer affectation";}
<div class="row justify-content-center"><div class="col-lg-5"><div class="card-panel text-center">
    <div class="delete-icon mb-3"><i class="bi bi-trash-fill text-danger"></i></div>
    <h5>Supprimer cette affectation ?</h5>
    <div class="alert alert-warning text-start py-2 small">
        <strong>Professeur :</strong> @Model.Professeur?.NomComplet<br/>
        <strong>Module :</strong> @Model.Module?.Libelle<br/>
        <strong>Date :</strong> @Model.Date_affectation.ToString("dd/MM/yyyy")
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id"/>
        @Html.AntiForgeryToken()
        <div class="d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Supprimer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
