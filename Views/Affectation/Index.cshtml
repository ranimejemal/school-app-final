@model IEnumerable<Affectation>
@{ViewData["Title"] = "Affectations";}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="page-title mb-0"><i class="bi bi-arrow-left-right me-2 text-info"></i>Affectations Professeur-Module</h4>
    <a asp-action="Create" class="btn btn-primary-custom"><i class="bi bi-plus-lg me-1"></i>Affecter</a>
</div>
<div class="card-panel">
    <table class="table table-clean">
        <thead><tr><th>Professeur</th><th>Module</th><th>Date</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="avatar-sm">@a.Professeur?.Prenom[0]@a.Professeur?.Nom[0]</div>
                        <span class="fw-semibold small">@a.Professeur?.NomComplet</span>
                    </div>
                </td>
                <td><span class="badge badge-group">@a.Module?.Libelle</span></td>
                <td><small class="text-muted">@a.Date_affectation.ToString("dd/MM/yyyy")</small></td>
                <td class="text-end">
                    <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">Aucune affectation.</td></tr> }
        </tbody>
    </table>
</div>
