@model Professeur
@{ViewData["Title"] = "Détails professeur";}
<div class="d-flex gap-2 mb-4 align-items-center">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
    <h4 class="page-title mb-0"><i class="bi bi-person-lines-fill text-info me-2"></i>@Model.NomComplet</h4>
</div>
<div class="row g-4">
    <div class="col-md-4">
        <div class="card-panel text-center">
            <div class="avatar-lg mx-auto mb-3">@Model.Prenom[0]@Model.Nom[0]</div>
            <h5 class="mb-1">@Model.NomComplet</h5>
            <p class="text-muted small mb-2">CIN : @Model.Cin</p>
            <hr/>
            <div class="text-start small">
                <div class="mb-2"><i class="bi bi-envelope text-muted me-2"></i>@Model.Email</div>
                <div class="mb-2"><i class="bi bi-telephone text-muted me-2"></i>@Model.Tel</div>
                <div class="mb-2"><i class="bi bi-calendar3 text-muted me-2"></i>Né(e) le @Model.Date_nais.ToString("dd/MM/yyyy")</div>
                <div><i class="bi bi-briefcase text-muted me-2"></i>Embauché le @Model.Date_emb.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card-panel">
            <div class="panel-header"><h6><i class="bi bi-arrow-left-right text-primary me-2"></i>Modules affectés (@Model.Affectations.Count)</h6></div>
            @if (Model.Affectations.Any())
            {
                <table class="table table-clean table-sm">
                    <thead><tr><th>Module</th><th>Date d'affectation</th></tr></thead>
                    <tbody>
                    @foreach (var a in Model.Affectations)
                    {
                        <tr>
                            <td>@a.Module?.Libelle</td>
                            <td><small class="text-muted">@a.Date_affectation.ToString("dd/MM/yyyy")</small></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else { <p class="text-muted text-center py-3">Aucune affectation.</p> }
        </div>
    </div>
</div>
