@model Professeur
@{ViewData["Title"] = "Modifier professeur";}
<div class="row justify-content-center"><div class="col-lg-8"><div class="card-panel">
    <h5 class="mb-4"><i class="bi bi-pencil-square text-warning me-2"></i>Modifier : @Model.NomComplet</h5>
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id"/>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Cin" class="form-label fw-semibold"></label><input asp-for="Cin" class="form-control"/><span asp-validation-for="Cin" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Date_emb" class="form-label fw-semibold"></label><input asp-for="Date_emb" type="date" class="form-control"/><span asp-validation-for="Date_emb" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Nom" class="form-label fw-semibold"></label><input asp-for="Nom" class="form-control"/><span asp-validation-for="Nom" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Prenom" class="form-label fw-semibold"></label><input asp-for="Prenom" class="form-control"/><span asp-validation-for="Prenom" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Date_nais" class="form-label fw-semibold"></label><input asp-for="Date_nais" type="date" class="form-control"/><span asp-validation-for="Date_nais" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label fw-semibold"></label><input asp-for="Email" type="email" class="form-control"/><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Tel" class="form-label fw-semibold"></label><input asp-for="Tel" class="form-control"/><span asp-validation-for="Tel" class="text-danger small"></span></div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-warning text-white"><i class="bi bi-check-lg me-1"></i>Mettre à jour</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
