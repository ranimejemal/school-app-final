@model Professeur
@{ViewData["Title"] = "Supprimer professeur";}
<div class="row justify-content-center"><div class="col-lg-6">
<div class="card-panel border border-danger border-opacity-25">
    <h5 class="text-danger mb-3"><i class="bi bi-person-x-fill me-2"></i>Supprimer le professeur</h5>
    <div class="alert alert-danger py-2 small">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        <strong>Suppression définitive :</strong> Le profil du professeur <em>et</em> son compte de connexion seront supprimés de façon permanente et irréversible.
    </div>
    <table class="table table-sm mt-3">
        <tr><th>Nom</th><td>@Model.Nom @Model.Prenom</td></tr>
        <tr><th>CIN</th><td>@Model.Cin</td></tr>
        <tr><th>Email</th><td>@Model.Email</td></tr>
        <tr><th>Login</th><td><span class="badge bg-secondary">@(Model.Email.Split('@')[0])</span></td></tr>
    </table>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i>Supprimer définitivement</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
