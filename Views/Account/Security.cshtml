@{
    ViewData["Title"] = "Sécurité du compte";
    var is2fa       = (bool)(ViewData["Is2faEnabled"] ?? false);
    var loginTime   = ViewData["LoginTime"] as string;
    var userAgent   = ViewData["UserAgent"] as string;
    var failedCount = (int)(ViewData["FailedCount"] ?? 0);
    DateTime? parsedLogin = loginTime != null ? DateTime.Parse(loginTime).ToLocalTime() : (DateTime?)null;
}

<div>
<div class="d-flex align-items-center gap-3 mb-4">
    <div class="twofa-icon-wrap" style="margin:0;width:44px;height:44px;font-size:1.3rem;border-radius:12px;">
        <i class="bi bi-shield-fill-check"></i>
    </div>
    <div>
        <h4 class="page-title mb-0">Sécurité du compte</h4>
        <p class="text-muted small mb-0">Gérez la sécurité et les paramètres de votre compte.</p>
    </div>
</div>

<div class="row g-4">
    <!-- 2FA Status -->
    <div class="col-md-6">
        <div class="card-panel">
            <div class="panel-header">
                <h6 class="mb-0"><i class="bi bi-phone me-2 text-primary"></i>Authentification 2FA</h6>
                <span class="badge @(is2fa ? "bg-success" : "bg-warning text-dark")">
                    @(is2fa ? "Activée" : "Désactivée")
                </span>
            </div>
            <p class="small text-muted mb-3">
                @(is2fa
                    ? "Votre compte est protégé par une deuxième couche de vérification."
                    : "Activez la 2FA pour renforcer la sécurité de votre compte.")
            </p>
            <a asp-action="TwoFactorSetup" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-@(is2fa ? "gear" : "shield-plus") me-1"></i>
                @(is2fa ? "Gérer la 2FA" : "Activer la 2FA")
            </a>
        </div>
    </div>

    <!-- Session info -->
    <div class="col-md-6">
        <div class="card-panel">
            <div class="panel-header">
                <h6 class="mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Session actuelle</h6>
            </div>
            <div class="session-item session-current mb-2">
                <i class="bi bi-display session-icon"></i>
                <div class="flex-grow-1">
                    <div class="fw-600 small">Cet appareil <span class="session-label">Actuel</span></div>
                    <div class="text-muted" style="font-size:.75rem;">
                        @(parsedLogin.HasValue ? parsedLogin.Value.ToString("dd/MM/yyyy HH:mm") : "Session en cours")
                    </div>
                    @if (!string.IsNullOrEmpty(userAgent))
                    {
                        <div class="text-muted text-truncate" style="font-size:.7rem;max-width:220px;">@userAgent</div>
                    }
                </div>
            </div>
            <div class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>
                @failedCount tentative(s) échouée(s) récente(s)
            </div>
        </div>
    </div>

    <!-- Change Password -->
    <div class="col-md-6">
        <div class="card-panel">
            <div class="panel-header">
                <h6 class="mb-0"><i class="bi bi-key me-2 text-primary"></i>Changer le mot de passe</h6>
            </div>
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <input type="password" name="currentPassword" class="form-control form-control-sm" placeholder="Mot de passe actuel" required/>
                </div>
                <div class="mb-2">
                    <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="Nouveau mot de passe (min. 6 car.)" required/>
                </div>
                <div class="mb-3">
                    <input type="password" name="confirmPassword" class="form-control form-control-sm" placeholder="Confirmer le nouveau mot de passe" required/>
                </div>
                <button type="submit" class="btn btn-primary-custom btn-sm w-100">
                    <i class="bi bi-key me-1"></i>Mettre à jour le mot de passe
                </button>
            </form>
        </div>
    </div>

    <!-- Security Tips -->
    <div class="col-md-6">
        <div class="card-panel">
            <div class="panel-header">
                <h6 class="mb-0"><i class="bi bi-lightbulb me-2 text-primary"></i>Conseils de sécurité</h6>
            </div>
            <ul class="small text-muted mb-0 ps-3">
                <li class="mb-2">Utilisez un mot de passe unique et fort (8+ caractères)</li>
                <li class="mb-2">Activez l'authentification à deux facteurs</li>
                <li class="mb-2">Ne partagez jamais vos identifiants</li>
                <li class="mb-2">Déconnectez-vous après chaque session sur un appareil partagé</li>
                <li>Vérifiez régulièrement les activités suspectes</li>
            </ul>
            <div class="mt-3 p-2 rounded small" style="background:rgba(26,86,219,.06);border:1px solid rgba(26,86,219,.15);">
                <i class="bi bi-info-circle me-1 text-primary"></i>
                Le compte est verrouillé après <strong>5 tentatives</strong> échouées pendant 5 min.
            </div>
        </div>
    </div>
</div>
</div>
