@model TwoFactorSetupViewModel
@{
    ViewData["Title"] = "Configuration 2FA";
}

<div class="content-area">
<div class="d-flex align-items-center gap-3 mb-4">
    <div class="twofa-icon-wrap" style="margin:0;width:44px;height:44px;font-size:1.3rem;border-radius:12px;">
        <i class="bi bi-shield-lock-fill"></i>
    </div>
    <div>
        <h4 class="page-title mb-0">Authentification à deux facteurs</h4>
        <p class="text-muted small mb-0">Sécurisez votre compte avec une couche de protection supplémentaire.</p>
    </div>
</div>

@if (Model.IsEnabled)
{
    <div class="card-panel mb-4">
        <div class="d-flex align-items-center gap-3 mb-3">
            <i class="bi bi-shield-check-fill text-success fs-3"></i>
            <div>
                <strong>2FA est activée</strong>
                <p class="text-muted small mb-0">Votre compte est protégé par l'authentification à deux facteurs.</p>
            </div>
        </div>
        <form asp-action="Disable2fa" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Désactiver la 2FA ?')">
                <i class="bi bi-shield-x me-1"></i>Désactiver la 2FA
            </button>
        </form>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card-panel h-100">
                <h6 class="fw-700 mb-3"><i class="bi bi-list-ol me-2 text-primary"></i>Étapes de configuration</h6>
                <div class="security-step"><span class="step-num">1</span>Téléchargez une application d'authentification (Google Authenticator, Authy…)</div>
                <div class="security-step"><span class="step-num">2</span>Scannez le QR code ou entrez la clé manuellement</div>
                <div class="security-step"><span class="step-num">3</span>Entrez le code à 6 chiffres pour confirmer</div>

                <div class="mt-4">
                    <p class="small text-muted fw-600 mb-1">Clé manuelle :</p>
                    <code class="d-block bg-light p-2 rounded small text-break">@Model.SharedKey</code>
                </div>

                <form asp-action="TwoFactorSetup" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <label class="form-label small fw-600">Code de vérification</label>
                    <div class="otp-inputs mb-3" id="otpGroup">
                        @for (int i = 0; i < 6; i++)
                        {
                            <input type="text" maxlength="1" class="otp-digit" data-idx="@i" inputmode="numeric"/>
                        }
                    </div>
                    <input type="hidden" asp-for="Code" id="codeHidden"/>
                    <button type="submit" class="btn btn-primary-custom w-100">
                        <i class="bi bi-shield-check me-2"></i>Activer la 2FA
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-6 d-flex flex-column gap-3">
            <div class="card-panel text-center">
                <h6 class="fw-700 mb-3"><i class="bi bi-qr-code me-2 text-primary"></i>QR Code</h6>
                <div class="qr-placeholder" id="qrContainer">
                    <div>
                        <i class="bi bi-qr-code-scan d-block fs-3 mb-2 text-muted"></i>
                        <span class="d-block">Génération du QR code…</span>
                        <a href="@Model.QrCodeUrl" class="d-block mt-2 small" target="_blank">Ouvrir dans une app</a>
                    </div>
                </div>
                <canvas id="qrCanvas" class="mt-3" style="display:none;border-radius:10px;"></canvas>
            </div>

            <div class="card-panel">
                <h6 class="fw-700 mb-2"><i class="bi bi-info-circle me-2 text-primary"></i>Pourquoi activer la 2FA ?</h6>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-1">Protection contre les mots de passe volés</li>
                    <li class="mb-1">Accès sécurisé même en cas de compromission</li>
                    <li>Conformité aux bonnes pratiques de sécurité</li>
                </ul>
            </div>
        </div>
    </div>
}
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    // OTP inputs
    const digits = document.querySelectorAll('.otp-digit');
    const hidden = document.getElementById('codeHidden');
    if (digits.length) {
        digits.forEach((d, i) => {
            d.addEventListener('input', e => {
                const val = e.target.value.replace(/\D/g,'');
                e.target.value = val.slice(-1);
                if (val && i < 5) digits[i+1].focus();
                hidden.value = [...digits].map(x=>x.value).join('');
            });
            d.addEventListener('keydown', e => {
                if (e.key === 'Backspace' && !d.value && i > 0) digits[i-1].focus();
            });
            d.addEventListener('paste', e => {
                e.preventDefault();
                const paste = (e.clipboardData||window.clipboardData).getData('text').replace(/\D/g,'');
                [...digits].forEach((x,j) => { x.value = paste[j]||''; });
                hidden.value = paste.slice(0,6);
                digits[Math.min(paste.length,5)].focus();
            });
        });
        digits[0].focus();
    }

    // QR code generation
    const qrUrl = '@Model.QrCodeUrl';
    if (qrUrl) {
        const canvas = document.getElementById('qrCanvas');
        const container = document.getElementById('qrContainer');
        try {
            new QRCode(canvas, { text: qrUrl, width: 160, height: 160, colorDark: '#0f172a', colorLight: '#ffffff' });
            canvas.style.display = 'block';
            container.style.display = 'none';
        } catch(e) { /* keep placeholder */ }
    }
</script>
}
