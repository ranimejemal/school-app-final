@model ForceChangePasswordViewModel
@{
    ViewData["Title"] = "Changement de mot de passe requis";
    Layout = null; // No layout - we render a standalone page with overlay
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Changement de mot de passe – SchoolApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #1e3a5f 0%, #2d6a9f 50%, #1a4a7a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        /* Blurred overlay backdrop */
        .overlay {
            position: fixed; inset: 0;
            background: rgba(10, 25, 50, 0.75);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        .popup-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.45);
            width: 100%;
            max-width: 460px;
            padding: 0;
            overflow: hidden;
            animation: slideUp .35s cubic-bezier(.22,.68,0,1.2) both;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(40px) scale(.96); }
            to   { opacity: 1; transform: translateY(0)   scale(1); }
        }

        .popup-header {
            background: linear-gradient(135deg, #1e3a5f, #2d6a9f);
            color: #fff;
            padding: 28px 32px 24px;
            position: relative;
        }

        .popup-header .icon-ring {
            width: 60px; height: 60px;
            background: rgba(255,255,255,0.15);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 14px;
        }

        .popup-header h4 { font-size: 1.25rem; font-weight: 700; margin-bottom: 6px; }
        .popup-header p  { font-size: .875rem; opacity: .85; margin: 0; }

        .popup-body { padding: 28px 32px 32px; }

        .form-label { font-weight: 600; font-size: .875rem; color: #374151; margin-bottom: 6px; }

        .form-control {
            border: 1.5px solid #d1d5db;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: .95rem;
            transition: border-color .2s, box-shadow .2s;
        }
        .form-control:focus {
            border-color: #2d6a9f;
            box-shadow: 0 0 0 3px rgba(45,106,159,.15);
            outline: none;
        }

        .input-group .form-control { border-radius: 10px 0 0 10px; }
        .input-group .btn-eye {
            border: 1.5px solid #d1d5db;
            border-left: none;
            border-radius: 0 10px 10px 0;
            background: #f9fafb;
            color: #6b7280;
            padding: 0 14px;
            cursor: pointer;
        }
        .input-group .btn-eye:hover { background: #f3f4f6; }

        .btn-change {
            background: linear-gradient(135deg, #1e3a5f, #2d6a9f);
            color: #fff;
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
            font-size: 1rem;
            width: 100%;
            cursor: pointer;
            transition: opacity .2s, transform .1s;
            margin-top: 8px;
        }
        .btn-change:hover { opacity: .92; }
        .btn-change:active { transform: scale(.98); }

        .strength-bar {
            height: 4px; border-radius: 4px;
            background: #e5e7eb;
            margin-top: 6px;
            overflow: hidden;
        }
        .strength-fill {
            height: 100%;
            width: 0%;
            border-radius: 4px;
            transition: width .3s, background .3s;
        }
        .strength-label { font-size: .75rem; color: #6b7280; margin-top: 4px; }

        .alert-danger { border-radius: 10px; font-size: .875rem; }

        .notice {
            background: #fffbeb;
            border: 1px solid #fcd34d;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: .82rem;
            color: #92400e;
            margin-bottom: 20px;
        }
        .notice i { margin-right: 6px; }
    </style>
</head>
<body>
<div class="overlay">
    <div class="popup-card">
        <div class="popup-header">
            <div class="icon-ring">
                <i class="bi bi-shield-lock-fill fs-4"></i>
            </div>
            <h4>Changement de mot de passe requis</h4>
            <p>Pour votre sécurité, veuillez définir un nouveau mot de passe personnel avant de continuer.</p>
        </div>

        <div class="popup-body">
            <div class="notice">
                <i class="bi bi-info-circle-fill"></i>
                Votre compte a été créé par l'administrateur. Ce mot de passe temporaire doit être changé maintenant.
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3">
                    <asp-validation-summary="All"></asp-validation-summary>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="ForceChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">
                        <i class="bi bi-key me-1"></i>Nouveau mot de passe
                    </label>
                    <div class="input-group">
                        <input asp-for="NewPassword" type="password" class="form-control"
                               placeholder="Minimum 6 caractères" id="newPwd" autocomplete="new-password" />
                        <button type="button" class="btn-eye" onclick="togglePwd('newPwd', this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                    <div class="strength-label" id="strengthLabel">Force du mot de passe</div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="bi bi-check2-circle me-1"></i>Confirmer le mot de passe
                    </label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword" type="password" class="form-control"
                               placeholder="Répétez le mot de passe" id="confirmPwd" autocomplete="new-password" />
                        <button type="button" class="btn-eye" onclick="togglePwd('confirmPwd', this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-change">
                    <i class="bi bi-check-lg me-2"></i>Enregistrer mon mot de passe
                </button>
            </form>
        </div>
    </div>
</div>

<script>
function togglePwd(id, btn) {
    const input = document.getElementById(id);
    const icon  = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
}

const strengthColors = ['#ef4444','#f97316','#eab308','#22c55e','#16a34a'];
const strengthLabels = ['Très faible','Faible','Moyen','Fort','Très fort'];

document.getElementById('newPwd').addEventListener('input', function() {
    const pwd = this.value;
    let score = 0;
    if (pwd.length >= 6)  score++;
    if (pwd.length >= 10) score++;
    if (/[A-Z]/.test(pwd)) score++;
    if (/[0-9]/.test(pwd)) score++;
    if (/[^A-Za-z0-9]/.test(pwd)) score++;
    const pct = (score / 5) * 100;
    const fill = document.getElementById('strengthFill');
    fill.style.width = pct + '%';
    fill.style.background = strengthColors[Math.max(score-1,0)];
    document.getElementById('strengthLabel').textContent = pwd.length > 0 ? strengthLabels[Math.max(score-1,0)] : 'Force du mot de passe';
});
</script>
</body>
</html>
