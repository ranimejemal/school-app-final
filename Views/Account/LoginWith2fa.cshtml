@model TwoFactorVerifyViewModel
@{
    Layout = null;
    ViewData["Title"] = "Vérification 2FA";
    var returnUrl  = ViewData["ReturnUrl"]  as string ?? "";
    var rememberMe = (bool)(ViewData["RememberMe"] ?? false);
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>SchoolApp – 2FA</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css"/>
</head>
<body class="login-body">
<div class="d-flex align-items-center justify-content-center" style="min-height:100vh;padding:20px;">
    <div class="twofa-card">
        <div class="twofa-icon-wrap">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h2 class="text-center fw-800 mb-1" style="font-weight:800;">Vérification à deux facteurs</h2>
        <p class="text-center text-muted small mb-4">Entrez le code à 6 chiffres affiché dans votre application d'authentification.</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <form asp-action="LoginWith2fa" asp-route-returnUrl="@returnUrl" asp-route-rememberMe="@rememberMe" method="post">
            @Html.AntiForgeryToken()
            <div class="otp-inputs mb-3" id="otpGroup">
                @for (int i = 0; i < 6; i++)
                {
                    <input type="text" maxlength="1" class="otp-digit" data-idx="@i" inputmode="numeric" pattern="[0-9]" autocomplete="off"/>
                }
            </div>
            <input type="hidden" asp-for="Code" id="codeHidden"/>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="RememberMachine" id="rememberMachine"/>
                <label class="form-check-label small" for="rememberMachine">Se souvenir de cet appareil pendant 30 jours</label>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 mb-3">
                <i class="bi bi-shield-check me-2"></i>Vérifier
            </button>
        </form>

        <div class="text-center">
            <a asp-action="Login" class="small text-muted"><i class="bi bi-arrow-left me-1"></i>Retour à la connexion</a>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
<script>
    const digits = document.querySelectorAll('.otp-digit');
    const hidden = document.getElementById('codeHidden');

    digits.forEach((d, i) => {
        d.addEventListener('input', e => {
            const val = e.target.value.replace(/\D/g,'');
            e.target.value = val.slice(-1);
            if (val && i < 5) digits[i+1].focus();
            hidden.value = [...digits].map(x=>x.value).join('');
        });
        d.addEventListener('keydown', e => {
            if (e.key === 'Backspace' && !d.value && i > 0) digits[i-1].focus();
        });
        d.addEventListener('paste', e => {
            e.preventDefault();
            const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g,'');
            [...digits].forEach((x,j) => { x.value = paste[j] || ''; });
            hidden.value = paste.slice(0,6);
            digits[Math.min(paste.length,5)].focus();
        });
    });
    digits[0].focus();
</script>
</body>
</html>
