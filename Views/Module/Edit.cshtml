@model SchoolApp.Models.Module
@{ViewData["Title"] = "Modifier module";}
<div class="row justify-content-center"><div class="col-lg-5"><div class="card-panel">
    <h5 class="mb-4"><i class="bi bi-pencil-square text-warning me-2"></i>Modifier module</h5>
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id_m"/>
        <div class="mb-3"><label asp-for="Libelle" class="form-label fw-semibold"></label><input asp-for="Libelle" class="form-control"/><span asp-validation-for="Libelle" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Duree" class="form-label fw-semibold"></label><input asp-for="Duree" type="number" class="form-control"/><span asp-validation-for="Duree" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Coef" class="form-label fw-semibold"></label><input asp-for="Coef" type="number" class="form-control"/><span asp-validation-for="Coef" class="text-danger small"></span></div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-warning text-white">Mettre à jour</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
