@model Examen
@{ViewData["Title"] = "Nouvel examen";}
<div class="row justify-content-center"><div class="col-lg-5"><div class="card-panel">
    <h5 class="mb-4"><i class="bi bi-plus-circle text-primary me-2"></i>Nouvel examen</h5>
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="mb-3"><label asp-for="EtudiantId" class="form-label fw-semibold"></label><select asp-for="EtudiantId" class="form-select" asp-items="ViewBag.EtudiantId"><option value="">— Choisir —</option></select><span asp-validation-for="EtudiantId" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="ModuleId" class="form-label fw-semibold"></label><select asp-for="ModuleId" class="form-select" asp-items="ViewBag.ModuleId"><option value="">— Choisir —</option></select><span asp-validation-for="ModuleId" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Date_Ex" class="form-label fw-semibold"></label><input asp-for="Date_Ex" type="date" class="form-control"/><span asp-validation-for="Date_Ex" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Note_Ex" class="form-label fw-semibold"></label><input asp-for="Note_Ex" type="number" step="0.01" min="0" max="20" class="form-control"/><span asp-validation-for="Note_Ex" class="text-danger small"></span></div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary-custom">Enregistrer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
