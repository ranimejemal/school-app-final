@model Examen
@{ViewData["Title"] = "Modifier examen";}
<div class="row justify-content-center"><div class="col-lg-5"><div class="card-panel">
    <h5 class="mb-4"><i class="bi bi-pencil-square text-warning me-2"></i>Modifier examen</h5>
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id"/>
        <div class="mb-3"><label asp-for="EtudiantId" class="form-label fw-semibold"></label><select asp-for="EtudiantId" class="form-select" asp-items="ViewBag.EtudiantId"></select></div>
        <div class="mb-3"><label asp-for="ModuleId" class="form-label fw-semibold"></label><select asp-for="ModuleId" class="form-select" asp-items="ViewBag.ModuleId"></select></div>
        <div class="mb-3"><label asp-for="Date_Ex" class="form-label fw-semibold"></label><input asp-for="Date_Ex" type="date" class="form-control"/></div>
        <div class="mb-3"><label asp-for="Note_Ex" class="form-label fw-semibold"></label><input asp-for="Note_Ex" type="number" step="0.01" min="0" max="20" class="form-control"/></div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-warning text-white">Mettre à jour</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
