@model Specialite
@{ViewData["Title"] = "Nouvelle spécialité";}
<div class="row justify-content-center"><div class="col-lg-5"><div class="card-panel">
    <h5 class="mb-4"><i class="bi bi-plus-circle text-primary me-2"></i>Nouvelle spécialité</h5>
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="mb-3">
            <label asp-for="Libelle" class="form-label fw-semibold"></label>
            <input asp-for="Libelle" class="form-control" placeholder="Ex : Informatique"/>
            <span asp-validation-for="Libelle" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary-custom">Enregistrer</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
