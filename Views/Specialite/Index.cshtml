@model IEnumerable<Specialite>
@{ViewData["Title"] = "Spécialités";}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="page-title mb-0"><i class="bi bi-bookmark-star-fill me-2 text-warning"></i>Spécialités</h4>
    <a asp-action="Create" class="btn btn-primary-custom"><i class="bi bi-plus-lg me-1"></i>Ajouter</a>
</div>
<div class="card-panel">
    <table class="table table-clean">
        <thead><tr><th>#</th><th>Libellé</th><th>Groupes</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td class="text-muted small">@s.Id_sp</td>
                <td class="fw-semibold">@s.Libelle</td>
                <td><span class="badge bg-light text-dark border">@s.Groupes.Count</span></td>
                <td class="text-end">
                    <a asp-action="Edit"   asp-route-id="@s.Id_sp" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@s.Id_sp" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-4">Aucune spécialité.</td></tr> }
        </tbody>
    </table>
</div>
