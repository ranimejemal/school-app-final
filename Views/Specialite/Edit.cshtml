@model Specialite
@{ViewData["Title"] = "Modifier spécialité";}
<div class="row justify-content-center"><div class="col-lg-5"><div class="card-panel">
    <h5 class="mb-4"><i class="bi bi-pencil-square text-warning me-2"></i>Modifier spécialité</h5>
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id_sp"/>
        <div class="mb-3">
            <label asp-for="Libelle" class="form-label fw-semibold"></label>
            <input asp-for="Libelle" class="form-control"/>
            <span asp-validation-for="Libelle" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning text-white">Mettre à jour</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div></div></div>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
