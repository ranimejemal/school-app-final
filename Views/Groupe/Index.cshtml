@model IEnumerable<Groupe>
@{ViewData["Title"] = "Groupes";}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="page-title mb-0"><i class="bi bi-diagram-3-fill me-2 text-success"></i>Groupes</h4>
    <a asp-action="Create" class="btn btn-primary-custom"><i class="bi bi-plus-lg me-1"></i>Ajouter</a>
</div>
<div class="card-panel">
    <table class="table table-clean">
        <thead><tr><th>Libellé</th><th>Niveau</th><th>Spécialité</th><th>Étudiants</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <td class="fw-semibold">@g.Libelle</td>
                <td><span class="badge badge-group">@g.Niveau?.Libelle</span></td>
                <td><span class="badge bg-light text-dark border">@g.Specialite?.Libelle</span></td>
                <td>@g.Etudiants.Count</td>
                <td class="text-end">
                    <a asp-action="Edit"   asp-route-id="@g.ID_gp" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@g.ID_gp" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-4">Aucun groupe.</td></tr> }
        </tbody>
    </table>
</div>
